{
    "name": "web-led",
    "private": true,
    "packageManager": "pnpm@10.15.1",
    "scripts": {
        "build": "pnpm --filter web build",
        "dev": "pnpm --filter web dev",
        "api:docs:build": "redocly build-docs docs/api/openapi.yaml -o docs/api/index.html",
        "api:docs:path": "tsx scripts/print-api-doc-url.ts",
        "api:docs": "pnpm run api:docs:build && pnpm run api:docs:path",
        "pio:build": "pio run",
        "pio:upload": "pio run -t upload",
        "pio:monitor": "pio run -t monitor",
        "pio:fs:upload": "pio run -t uploadfs",
        "pio:compiledb": "pio run -t compiledb"
    },
    "devDependencies": {
        "@redocly/cli": "^2.30.0",
        "@types/node": "^24.12.0",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tsx": "^4.7.0"
    }
}
